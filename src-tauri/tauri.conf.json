{
  "productName": "Correctify",
  "version": "1.0.3",
  "identifier": "com.correctify",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../out"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Correctify",
        "width": 950,
        "height": 950,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-window-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-hide",
            "core:window:allow-show",
            "shell:allow-open",
            "global-shortcut:default",
            "global-shortcut:allow-register",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-is-registered",
            "clipboard-manager:default",
            "clipboard-manager:allow-read-text",
            "clipboard-manager:allow-write-text",
            "notification:default",
            "os:allow-platform",
            "autostart:default",
            "autostart:allow-enable",
            "autostart:allow-disable",
            "autostart:allow-is-enabled",
            "core:app:allow-name",
            "core:app:allow-version",
            "updater:default",
            "updater:allow-check",
            "updater:allow-download",
            "updater:allow-install",
            "process:default",
            "process:allow-restart",
            "process:allow-exit",
            "dialog:allow-message"
          ]
        },
        {
          "identifier": "about-window-capability",
          "windows": ["about"],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "core:window:allow-show",
            "shell:allow-open"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "Developer ID Application: Tarik Kavaz (UHLJ8Z3YQA)",
      "minimumSystemVersion": "10.13",
      "dmg": {
        "background": "./images/dmg-background.png",
        "windowSize": {
          "width": 680,
          "height": 470
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tarikkavaz/Correctify/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRUEyQUIwMTMxNzVDOEQKUldTTlhCY1RzQ3JxM0xUa1pldC9IckF5RGRjdDMxcUQ2RldqZ0R3K1M0M3IvR1FicXo0aXlhUUQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
